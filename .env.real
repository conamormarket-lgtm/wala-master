# Modo "real": dev server local leyendo la Firebase de PRODUCCIÓN en vez de los
# emuladores. Sirve para ver cómo queda un cambio contra el catálogo de verdad.
#
#   npm run dev -- --mode real      (o la config "wala-dev-real" de launch.json)
#
# El flag ya estaba contemplado en src/services/firebase/config.js (USE_EMULATORS).
# OJO: lo que se escriba desde aquí va a producción. Para el día a día usa
# `npm run dev` a secas, que levanta contra emuladores.
VITE_USE_EMULATORS=false
