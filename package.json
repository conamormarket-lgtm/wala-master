  "private": true,
  "dependencies": {
    "@capacitor/android": "^8.2.0",
    "@capacitor/app": "latest",
    "@capacitor/core": "^8.2.0",
    "@capacitor/local-notifications": "^8.0.2",
    "@capacitor/push-notifications": "^8.1.1",
    "@codetrix-studio/capacitor-google-auth": "^3.3.6",
    "@paypal/react-paypal-js": "^9.3.0",
    "@tanstack/react-query": "^5.17.0",
    "an-array-of-spanish-words": "^2.0.0",
    "date-fns": "^3.0.6",
    "driver.js": "^1.4.0",
    "fabric": "^5.3.0",
    "firebase": "^10.7.0",
    "formik": "^2.4.5",
    "framer-motion": "^10.18.0",
    "html2canvas": "^1.4.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.8.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-easy-crop": "^5.5.6",
    "react-image-crop": "^11.1.2",
    "react-quill": "^2.0.0",
    "react-router-dom": "^6.30.3",
    "react-select": "^5.8.0",
    "recharts": "^2.10.3",
    "yup": "^1.3.3"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "dev:3001": "vite --port 3001",
    "build": "vite build && node scripts/build-componentes.mjs",
    "postinstall": "node scripts/patch-google-auth-gradle.js",
    "preview": "vite build --mode preview && vite preview",
    "preview:local": "npm run preview",
    "lint": "eslint src",
    "emulators": "node scripts/emulators.js",
    "seed": "node scripts/seed-emulator.js",
    "seed:landing-balvi": "node scripts/seed-landing-balvi.js",
    "seed:landing-balvi:prod": "node scripts/seed-landing-balvi.js --prod --confirm",
    "seed:landing-combo": "node scripts/seed-landing-combo.js",
    "seed:landing-combo:prod": "node scripts/seed-landing-combo.js --prod --confirm",
    "seed:landing-billetera": "node scripts/seed-landing-billetera.js",
    "seed:landing-billetera:prod": "node scripts/seed-landing-billetera.js --prod --confirm",
    "seed:recompensas": "node scripts/seed-recompensas.js",
    "seed:recompensas:prod": "node scripts/seed-recompensas.js --prod --confirm",
    "seed:misiones": "node scripts/seed-misiones.js",
    "seed:misiones:prod": "node scripts/seed-misiones.js --prod --confirm",
    "deploy:firestore-rules": "node scripts/deploy-firestore-rules.js",
    "deploy:storage-rules": "node scripts/deploy-storage-rules.js",
    "deploy:functions": "firebase deploy --only functions --project sistema-gestion-3b225",
    "deploy:indexes": "firebase deploy --only firestore:indexes --project sistema-gestion-3b225",
    "deploy:vercel": "npx vercel",
    "deploy:vercel:prod": "npx vercel --prod",
    "test:functions": "node functions/test/economyLogic.test.js && node functions/test/internationalAdvanceLogic.test.js && node functions/test/ruletaLogic.test.js && node functions/test/catalogPricing.test.js && node functions/test/fechasLogic.test.js && node functions/test/ordersLogic.test.js && node functions/test/productViewLogic.test.js && node functions/test/comunidadLogic.test.js && node functions/test/referidosLogic.test.js && node functions/test/bolitasLogic.test.js",
    "test:meta-pixel": "node --test src/services/analytics/metaPixel.test.mjs",
    "test:product-interest": "node --test src/services/analytics/productInterest.test.mjs",
    "test:popups": "node --test src/services/popupsLogic.test.mjs",
    "test:bolitas": "node --test src/componentes/kit/piezas/bolitasMotor.test.mjs src/componentes/kit/piezas/bolitasProgreso.test.mjs && node functions/test/bolitasLogic.test.js",
    "gen:motor-bolitas": "node scripts/generar-motor-bolitas.js",
    "test:gift": "node --test src/utils/giftRecommender.test.mjs src/utils/fechasFestivas.test.mjs src/utils/fechaEvento.test.mjs src/services/surveyResponses.test.mjs src/services/encuestaOrigen.test.mjs",
    "test:crear-productos": "node --test src/utils/laser.test.mjs src/pages/admin/plantillasYoryo/plantillasACapas.test.mjs functions/test/cartValidation.test.js functions/test/pedidoDisenos.test.js",
    "gen:gift-logic": "node scripts/gen-gift-logic.js",
    "test:analytics": "node --test functions/test/analyticsResultados.test.js functions/test/analyticsDailyReads.test.js functions/test/clientesBusqueda.test.js && node functions/test/analyticsTraficoReal.test.js && node functions/test/analyticsVisitas.test.js && node --experimental-vm-modules --test scripts/test/analyticsResultadosCliente.test.mjs && node --test src/pages/admin/resultados/cosasPorMejorar.test.mjs",
    "test:performance": "node --test functions/test/cartValidation.test.js functions/test/analyticsDailyReads.test.js src/services/shared/inFlightReads.test.mjs && node --experimental-vm-modules --test scripts/test/dataServices.test.mjs",
    "test:startup": "node --test src/pages/Tienda/services/startup.test.mjs scripts/test/storefrontBootstrap.test.mjs",
    "test:mobile-checkout": "node --test functions/test/mobileCheckout.test.js functions/test/mobileCulqiFlow.test.js functions/test/checkoutTotals.test.js functions/test/cartValidation.test.js"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.2.0",
    "@eslint/js": "^9.39.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^15.15.0",
    "typescript": "4.9.5",
    "vite": "^5.4.11"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
